{
  "name": "svcemun26",
  "version": "1.0.0",
  "description": "SVCE MUN 2026 - Official Website",
  "main": "index.html",
  "scripts": {
    "dev": "concurrently \"npm run watch:css\" \"npm run serve\"",
    "watch:css": "tailwindcss -i ./src/styles.css -o ./src/output.css --watch --poll",
    "build:css": "NODE_ENV=production tailwindcss -i ./src/styles.css -o ./src/output.css --minify",
    "build": "npm run build:css",
    "serve": "live-server --port=3000 --entry-file=./src/index.html",
    "start": "npm run serve"
  },
  "keywords": [
    "mun",
    "model-united-nations",
    "svce",
    "conference"
  ],
  "author": "SVCE Speakers' Forum",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "live-server": "^1.2.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18"
  },
  "dependencies": {
    "aos": "^2.3.4"
  }
}
